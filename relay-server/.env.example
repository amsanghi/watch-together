# Copy this file to ".env" and edit as needed. All values are optional.

# Local port the relay listens on (ngrok forwards its public link to this).
PORT=8787

# OPTIONAL — a FIXED ngrok domain so your link never changes between runs.
# Every free ngrok account gets one static domain. Claim yours at
#   https://dashboard.ngrok.com/domains
# then paste it here (no https://), e.g.
#   NGROK_DOMAIN=watch-together-yourname.ngrok-free.app
# Leave blank to get a new random URL each time you start.
NGROK_DOMAIN=

# OPTIONAL — Cloudflare Realtime TURN, so the CALL's audio/video can relay through a
# server when a direct peer-to-peer path can't be found (strict/symmetric NAT / CGNAT).
# The relay mints short-lived credentials from these and hands them to both extensions
# in its roster, so the token stays on the server and never ships in the (public)
# extension. Free tier: 1000 GB/mo. Set up at dash.cloudflare.com -> Realtime -> TURN
# -> create an app, then copy the two values. Tip: put these in ~/.watchtogether-relay.env
# instead of here so they survive install.command. Blank = calls use STUN only.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
